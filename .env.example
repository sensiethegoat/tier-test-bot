# Discord Developer Portal → your application → Bot → Reset Token
DISCORD_TOKEN=
# Discord Developer Portal → your application → General Information → Application ID
CLIENT_ID=
# Optional: register commands to one server only (instant updates while developing)
DEV_GUILD_ID=
# Optional: channel (in your own server) that receives /bugreport reports. Unset = DM the bot owner.
BUG_REPORT_CHANNEL_ID=
# Optional: turn modules off for every server (comma-separated): testing, community
DISABLED_MODULES=
# Optional: attach a .txt transcript when a support ticket closes. Also turn on
# "Message Content Intent" in the Developer Portal → Bot.
ENABLE_TRANSCRIPTS=false
# Optional: link shown by /about. If you run a MODIFIED version of this bot for others, the
# AGPL requires offering them your source: point this at your fork. Defaults to the upstream repo.
SOURCE_URL=
# Optional: where the SQLite database lives
DATABASE_PATH=data/bot.db
